{
  "name": "elemental-clash",
  "private": true,
  "version": "1.0.0",
  "description": "A 3D third-person arena fighting game with four elemental fighters, built with Three.js.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && node scripts/e2e.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "playwright": "1.56.1",
    "typescript": "~6.0.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  }
}
