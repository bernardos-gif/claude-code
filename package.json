{
  "name": "elemental-clash",
  "private": true,
  "version": "1.0.0",
  "description": "A 3D third-person arena fighting game with four elemental fighters, built with Three.js. Runs in the browser or as a desktop app.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && node scripts/e2e.mjs",
    "app": "npm run build && electron .",
    "app:dev": "ELECTRON_DEV_URL=http://localhost:5173 electron .",
    "app:smoke": "electron . --smoke-test",
    "dist:mac": "npm run build && electron-builder --mac --universal --publish never"
  },
  "devDependencies": {
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/teko": "^5.3.0",
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "playwright": "1.56.1",
    "three": "^0.186.1",
    "typescript": "~6.0.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "main": "electron/main.cjs",
  "author": "Elemental Clash",
  "build": {
    "appId": "com.elementalclash.game",
    "productName": "Elemental Clash",
    "copyright": "Elemental Clash",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.action-games",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dir",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": null,
      "darkModeSupport": true,
      "minimumSystemVersion": "12.0"
    }
  }
}
